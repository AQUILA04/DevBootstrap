<Project Sdk="WixToolset.Sdk/5.0.2">
  <!--
    Pinned WiX 5 MSI project for StackPilot.
    Builds a per-machine x64 MSI that installs the self-contained StackPilot.exe + catalog.json.
  -->
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>StackPilot-$(ProductVersion)-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>en-US</Cultures>
    <SuppressIces>ICE91</SuppressIces>
    <!-- Default publish folder produced by build.ps1 -Phase PublishExe -->
    <StackPilotPublishDir Condition="'$(StackPilotPublishDir)' == ''">$(MSBuildThisFileDirectory)..\..\dist\StackPilot\</StackPilotPublishDir>
    <DefineConstants>ProductVersion=$(ProductVersion);Company=$(Company);ProductName=$(ProductName);MsiUpgradeCode=$(MsiUpgradeCode);PackageProjectUrl=$(PackageProjectUrl);PrivacyPolicyUrl=$(PrivacyPolicyUrl);SupportUrl=$(SupportUrl)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <BindPath Include="$(StackPilotPublishDir)" BindName="PublishDir" />
    <BindPath Include="$(MSBuildThisFileDirectory)..\..\assets\icons\" BindName="Icons" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
