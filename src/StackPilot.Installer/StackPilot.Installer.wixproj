<Project Sdk="WixToolset.Sdk/5.0.2">
  <!--
    Pinned WiX 5 MSI project for StackPilot.
    Builds a per-machine x64 MSI that installs the self-contained StackPilot.exe + catalog.json.
    No WixUI: Microsoft Store MSI/EXE submissions require silent install.
  -->
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>StackPilot-$(ProductVersion)-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>en-US</Cultures>
    <SuppressIces>ICE57;ICE91</SuppressIces>
    <StackPilotPublishDir Condition="'$(StackPilotPublishDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\dist\StackPilot'))</StackPilotPublishDir>
    <StackPilotIconsDir Condition="'$(StackPilotIconsDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\assets\icons'))</StackPilotIconsDir>
    <!-- Normalize to forward-slash paths with trailing slash for WiX preprocessor vars. -->
    <_PublishDir>$([System.IO.Path]::GetFullPath('$(StackPilotPublishDir)').Replace('\','/').TrimEnd('/'))/</_PublishDir>
    <_IconsDir>$([System.IO.Path]::GetFullPath('$(StackPilotIconsDir)').Replace('\','/').TrimEnd('/'))/</_IconsDir>
    <DefineConstants>ProductVersion=$(ProductVersion);MsiUpgradeCode=$(MsiUpgradeCode);PublishDir=$(_PublishDir);IconsDir=$(_IconsDir)</DefineConstants>
  </PropertyGroup>
</Project>
